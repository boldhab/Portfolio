# Set only for an indexable production build at its verified HTTPS origin (e.g., https://boldhab.pro.et).
NEXT_PUBLIC_SITE_URL=

# Server-only. Use a Resend-verified sender and the intended inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Vercel only. Set to true after verifying the active contact rate-limit rule.
CONTACT_WAF_CONFIGURED=
